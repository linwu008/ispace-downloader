{
  "name": "bnbu-coursenest",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coursenest",
      "database_id": "743d0018-d56f-4e10-8d87-666613847f84",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "HELPER_DOWNLOAD_URL": "https://github.com/linwu008/coursenest-releases/releases/download/v0.7/CourseNestHelper-0.7.0-windows-x64.zip",
    "HELPER_SHA256": "2096aeb55cf7491b1e685b0eae26c229886a5a846438b21dde12ae8d12e541f1",
    "ARCHIVE_ENABLED": "0",
    "MAIL_ENABLED": "0",
    "PUBLIC_ORIGIN": "https://bnbucoursenest.cn",
    "INVITE_REQUIRED": "1",
    "QA_ENABLED": "0",
    "R2_WRITE_BUDGET": "800000",
    "R2_READ_BUDGET": "8000000",
    "USER_STORAGE_BYTES": "250000000",
    "GLOBAL_STORAGE_BYTES": "8000000000",
    "MAX_FILE_BYTES": "50000000",
    "AI_DAILY_NEURONS": "8000",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "HELPER_VERSION": "0.7.0",
    "HELPER_SIGNATURE": "am1wFPMcZ4TcpCT0OqzGvZXUHFrFNjDSSoDakaWGGsShKpGFei0VqoWez90fH1LbDUrGkNR7pdOUv1FwTW8JAg==",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
}
